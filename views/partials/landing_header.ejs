<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wapi XCD - Gateway WhatsApp Anda</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

    <style>
        /* ===========================
           NAVBAR MODERN
        ============================ */
        .navbar-modern {
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(12px);
            padding: 14px 0;
            transition: 0.3s;
        }

        .navbar-modern .navbar-brand {
            font-size: 1.6rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 1px;
        }

        .navbar-modern .nav-link {
            font-size: 1rem;
            font-weight: 500;
            color: #e2e8f0 !important;
            margin-right: 18px;
            transition: 0.3s;
        }

        .navbar-modern .nav-link:hover {
            color: #38bdf8 !important;
        }

        .btn-login {
            background: transparent;
            border: 2px solid #38bdf8;
            color: #38bdf8;
            padding: 8px 22px;
            border-radius: 50px;
            transition: 0.3s;
        }

        .btn-login:hover {
            background: #38bdf8;
            color: #0f172a;
        }

        .btn-register {
            background: linear-gradient(135deg, #6366f1, #9333ea);
            border: none;
            padding: 8px 26px;
            border-radius: 50px;
            color: white;
            font-weight: 600;
            box-shadow: 0 8px 20px rgba(99,102,241,0.45);
            transition: 0.3s;
        }

        .btn-register:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(99,102,241,0.55);
        }

        /* Sticky Navbar on Scroll */
        .navbar-scrolled {
            background: rgba(15, 23, 42, 0.85) !important;
            box-shadow: 0 4px 25px rgba(0,0,0,0.2);
        }
    </style>
</head>

<body>

    <!-- ===========================
         HEADER NAVBAR
    ============================ -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-modern fixed-top" id="navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="bx bxs-message-dots me-2 bx-md"></i> Wapi XCD
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                aria-label="Toggle navigation">
                <i class="bx bx-menu bx-sm text-white"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Fitur</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#pricing">Harga</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#docs">Dokumentasi</a>
                    </li>

                    <li class="nav-item ms-2">
                        <a class="btn-login" href="/login">Login</a>
                    </li>

                    <li class="nav-item ms-2">
                        <a class="btn-register" href="/register">Daftar Gratis</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Navbar Scroll Effect -->
    <script>
        const navbar = document.getElementById("navbar");
        window.addEventListener("scroll", () => {
            if (window.scrollY > 20) {
                navbar.classList.add("navbar-scrolled");
            } else {
                navbar.classList.remove("navbar-scrolled");
            }
        });
    </script>

</body>
</html>