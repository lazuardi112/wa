<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verifikasi OTP - Wapi XCD</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap">
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<body>
  <div class="auth-container">
    <h1 class="title">Periksa WhatsApp Anda</h1>
    <p class="text-center">Kami telah mengirimkan OTP 6 digit ke nomor Anda. Silakan masukkan di bawah ini.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <p class="alert alert-danger"><%= error %></p>
    <% } %>

    <form action="/api/v1/auth/verify-otp" method="POST">
      <input type="hidden" name="userId" value="<%= userId %>">
      <div class="form-group">
        <label for="otp">Kode OTP</label>
        <input type="text" id="otp" name="otp" maxlength="6" required style="text-align: center; font-size: 1.2rem;">
      </div>
      <button type="submit" class="btn">Verifikasi & Masuk</button>
    </form>
  </div>
</body>
</html>
