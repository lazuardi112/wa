<%- include('partials/header', { title: 'Perangkat', active: 'devices' }) %>

<div class="header">
  <h1>Kelola Perangkat Anda</h1>
  <% if (canAddDevice) { %>
    <button id="open-modal-btn" class="btn">Tambah Perangkat Baru</button>
  <% } else { %>
    <div class="limit-info">
      <p>Anda telah mencapai batas perangkat Anda (<%= limit %>).</p>
      <a href="/subscribe" class="btn">Tingkatkan Paket</a>
    </div>
  <% } %>
</div>

<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>Nama Perangkat</th>
        <th>ID Instans</th>
        <th>Status</th>
        <th>Tindakan</th>
      </tr>
    </thead>
    <tbody id="device-list">
      <% if (!devices || devices.length === 0) { %>
        <tr>
          <td colspan="4" class="text-center">Anda belum memiliki perangkat.</td>
        </tr>
      <% } else { %>
        <% devices.forEach(device => { %>
          <tr data-device-id="<%= device.id %>" data-instance-id="<%= device.instanceId %>">
            <td><%= device.remark %></td>
            <td><%= device.instanceId %></td>
            <td><span class="status status-<%= device.status.toLowerCase() %>"><%= device.status %></span></td>
            <td>
              <% if (device.status.toLowerCase() !== 'connected') { %>
                <button class="btn btn-sm" onclick="handleReconnect('<%= device.id %>', '<%= device.instanceId %>')">Hubungkan</button>
              <% } %>
              <button class="btn btn-sm btn-danger" onclick="deleteDevice('<%= device.id %>')">Hapus</button>
            </td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Modal -->
<div id="add-device-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modal-title">Tambah Perangkat WhatsApp Baru</h2>
      <span class="close-btn">&times;</span>
    </div>
    <div class="modal-body">
      <p id="modal-description">Masukkan nama untuk perangkat Anda dan klik "Hasilkan QR".</p>
      <div id="modal-input-container">
        <input type="text" id="device-name-input" placeholder="contoh: Telepon Bisnis">
        <button id="generate-qr-btn" class="btn">Hasilkan QR</button>
      </div>
      <div id="qr-code-container" style="display: none;">
        <!-- QR Code atau teks memuat akan ditampilkan di sini -->
      </div>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<%- include('partials/footer') %>
