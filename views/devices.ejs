<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Devices</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a.active, .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        .header { display: flex; justify-content: space-between; align-items: center; }
        h1 { color: #007bff; }
        .btn { background-color: #007bff; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; font-size: 1rem; }
        .btn-danger { background-color: #dc3545; }
        table { width: 100%; border-collapse: collapse; margin-top: 2rem; }
        th, td { padding: 1rem; text-align: left; border-bottom: 1px solid #333; }
        .status-connected { color: #28a745; font-weight: bold; }
        .status-disconnected { color: #dc3545; font-weight: bold; }
        .status-pending { color: #ffc107; font-weight: bold; }

        /* Modal Styles */
        .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.7); }
        .modal-content { background-color: #1e1e1e; margin: 10% auto; padding: 2rem; border: 1px solid #888; width: 80%; max-width: 400px; border-radius: 8px; text-align: center; }
        .close-btn { color: #aaa; float: right; font-size: 28px; font-weight: bold; cursor: pointer; }
        .close-btn:hover, .close-btn:focus { color: white; }
        #qr-code-container { margin-top: 1.5rem; }
        #qr-code-display { background: white; padding: 1rem; border-radius: 8px; display: inline-block; line-height: 0; }
        #qr-code-container .loading-text { color: white; }
        input[type="text"] { width: calc(100% - 2rem); padding: 0.75rem; margin-bottom: 1rem; border: 1px solid #333; background-color: #2c2c2c; color: white; border-radius: 4px; }

        /* Loading animation */
        .dots { display: inline-block; }
        @keyframes dots {
            0%, 20% { color: rgba(255,255,255,0); text-shadow: .25em 0 0 rgba(255,255,255,0), .5em 0 0 rgba(255,255,255,0); }
            40% { color: white; text-shadow: .25em 0 0 rgba(255,255,255,0), .5em 0 0 rgba(255,255,255,0); }
            60% { text-shadow: .25em 0 0 white, .5em 0 0 rgba(255,255,255,0); }
            80%, 100% { text-shadow: .25em 0 0 white, .5em 0 0 white; }
        }
        .dots::after { content: '...'; animation: dots 1.4s infinite; }
    </style>
</head>
<body>
    <%- include('partials/sidebar', { active: 'devices' }) %>

    <div class="main-content">
        <div class="header">
            <h1>Manage Your Devices</h1>
            <button id="open-modal-btn" class="btn">Add New Device</button>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Device Name</th>
                    <th>Session ID</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="device-list">
                <% devices.forEach(device => { %>
                    <tr data-device-id="<%= device.id %>" data-session-id="<%= device.sessionId %>">
                        <td><%= device.name %></td>
                        <td><%= device.sessionId %></td>
                        <td class="status-<%= device.status.toLowerCase() %>"><%= device.status %></td>
                        <td>
                            <% if (device.status.toLowerCase() !== 'connected') { %>
                                <button class="btn" onclick="handleReconnect('<%= device.id %>', '<%= device.sessionId %>')">Connect</button>
                            <% } %>
                            <button class="btn btn-danger" onclick="deleteDevice('<%= device.id %>')">Delete</button>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- The Modal -->
    <div id="add-device-modal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>
            <h2 id="modal-title">Add New WhatsApp Device</h2>
            <p id="modal-description">Enter a name for your device and click "Generate QR".</p>
            <div id="modal-input-container">
                <input type="text" id="device-name-input" placeholder="e.g., Business Phone">
                <button id="generate-qr-btn" class="btn">Generate QR</button>
            </div>
            <div id="qr-code-container" style="display: none;">
                <!-- QR Code or loading text will be rendered here -->
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const modal = document.getElementById('add-device-modal');
        const openModalBtn = document.getElementById('open-modal-btn');
        const closeModalBtn = document.querySelector('.close-btn');
        const generateQrBtn = document.getElementById('generate-qr-btn');
        const qrCodeContainer = document.getElementById('qr-code-container');
        const deviceNameInput = document.getElementById('device-name-input');

        const modalTitle = document.getElementById('modal-title');
        const modalDescription = document.getElementById('modal-description');
        const modalInputContainer = document.getElementById('modal-input-container');

        const socket = io();
        let currentSessionId = null;

        socket.on('connect', () => {
            console.log('Socket connected:', socket.id);
            // Re-join rooms for existing devices on page load/reconnect
            document.querySelectorAll('#device-list tr').forEach(row => {
                const sessionId = row.dataset.sessionId;
                if (sessionId) {
                    console.log(`Joining room: ${sessionId}`);
                    socket.emit('join_room', sessionId);
                }
            });
        });

        socket.on('qr_code', (qrCodeDataUrl) => {
            console.log('QR code received');
            qrCodeContainer.style.display = 'block';
            qrCodeContainer.innerHTML = `<img id="qr-code-display" src="${qrCodeDataUrl}" alt="QR Code">`;
        });

        socket.on('status_update', (data) => {
            console.log('Status update received:', data);

            if (data.status === 'CONNECTED' && data.sessionId === currentSessionId) {
                alert(data.message || 'Device connected successfully!');
                window.location.reload();
                return;
            }

            const row = document.querySelector(`tr[data-session-id="${data.sessionId}"]`);
            if (row) {
                 // Reloading is a simple way to reflect all changes (like button states)
                 // A more advanced implementation would update the DOM dynamically
                 alert(`Device "${row.querySelector('td:first-child').innerText}" status changed to: ${data.status}. Page will reload.`);
                 window.location.reload();
            }
        });

        const resetModal = () => {
            modalTitle.textContent = 'Add New WhatsApp Device';
            modalDescription.textContent = 'Enter a name for your device and click "Generate QR".';
            modalInputContainer.style.display = 'block';
            deviceNameInput.value = '';
            qrCodeContainer.style.display = 'none';
            qrCodeContainer.innerHTML = '';
            currentSessionId = null;
        };

        const openModal = () => {
            resetModal();
            modal.style.display = 'block';
        };

        const closeModal = () => {
            modal.style.display = 'none';
            currentSessionId = null; // Clear session ID on modal close
        };

        openModalBtn.onclick = openModal;
        closeModalBtn.onclick = closeModal;
        window.onclick = (event) => {
            if (event.target == modal) {
                closeModal();
            }
        };

        generateQrBtn.addEventListener('click', async () => {
            const deviceName = deviceNameInput.value.trim();
            if (!deviceName) {
                alert('Please enter a name for the device.');
                return;
            }

            qrCodeContainer.style.display = 'block';
            qrCodeContainer.innerHTML = '<p class="loading-text">Generating QR code, please wait<span class="dots">...</span></p>';

            try {
                const response = await fetch('/api/v1/devices', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ deviceName }),
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || 'Failed to create device.');
                }

                const data = await response.json();
                currentSessionId = data.sessionId;
                console.log(`Device created. Session ID: ${currentSessionId}. Joining room.`);
                socket.emit('join_room', currentSessionId);

            } catch (error) {
                qrCodeContainer.innerHTML = `<p style="color: red;">Error: ${error.message}</p>`;
            }
        });

        async function handleReconnect(deviceId, sessionId) {
            resetModal();
            modal.style.display = 'block';

            currentSessionId = sessionId;
            socket.emit('join_room', currentSessionId);

            modalTitle.textContent = 'Reconnect Device';
            modalDescription.textContent = 'Please scan the new QR code to reconnect your device.';
            modalInputContainer.style.display = 'none'; // Hide input for reconnecting

            qrCodeContainer.style.display = 'block';
            qrCodeContainer.innerHTML = '<p class="loading-text">Requesting new QR code, please wait<span class="dots">...</span></p>';

            try {
                const response = await fetch('/api/v1/devices/reconnect', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ deviceId }),
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || 'Failed to reconnect device.');
                }
                // QR code will be delivered via the 'qr_code' socket event
                console.log('Reconnect request successful. Waiting for QR code via socket...');

            } catch (error) {
                qrCodeContainer.innerHTML = `<p style="color: red;">Error: ${error.message}</p>`;
            }
        }

        async function deleteDevice(deviceId) {
            if (!confirm('Are you sure you want to delete this device? This cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch(`/api/v1/devices/${deviceId}`, {
                    method: 'DELETE',
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || 'Failed to delete device.');
                }

                alert('Device deleted successfully.');
                window.location.reload();
            } catch (error) {
                alert(`Error: ${error.message}`);
            }
        }
    </script>
</body>
</html>
