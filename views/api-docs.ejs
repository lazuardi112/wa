<%- include('partials/header', { title: 'Dokumentasi API', active: 'api-docs' }) %>

<div class="header">
  <h1>Dokumentasi API</h1>
</div>

<div class="card">
  <h2>Kunci API Anda</h2>
  <div class="api-key-section">
    <% if (apiKey) { %>
      <p><strong>Kunci API baru Anda:</strong> Harap simpan kunci ini. Kunci ini tidak akan ditampilkan lagi.</p>
      <code><%= apiKey %></code>
    <% } else if (apiKeyExists) { %>
      <p>Anda sudah memiliki kunci API. Untuk keamanan, kunci ini hanya ditampilkan sekali. Jika hilang, Anda harus membuat yang baru, yang akan membatalkan kunci yang lama.</p>
      <form action="/api/v1/user/generate-apikey" method="POST" onsubmit="return confirm('Apakah Anda yakin? Membuat kunci baru akan membatalkan kunci lama Anda.');">
        <button type="submit" class="btn">Buat Kunci API Baru</button>
      </form>
    <% } else { %>
      <p>Anda belum membuat kunci API.</p>
      <form action="/api/v1/user/generate-apikey" method="POST">
        <button type="submit" class="btn">Buat Kunci API</button>
      </form>
    <% } %>
  </div>
</div>

<div class="card">
  <h2>Penggunaan API</h2>
  <h3>Autentikasi</h3>
  <p>Semua permintaan API harus menyertakan kunci API Anda di header <code>x-api-key</code>.</p>
  <pre><code>x-api-key: KUNCI_API_ANDA</code></pre>

  <h3>URL Dasar</h3>
  <p>URL dasar untuk semua titik akhir API adalah:</p>
  <pre><code>https://xcd.xcreate.my.id</code></pre>

  <h3>Parameter Wajib: <code>deviceId</code></h3>
  <p>Semua permintaan pengiriman pesan harus menyertakan <code>deviceId</code> untuk menentukan perangkat mana yang harus digunakan. Anda dapat menemukan <strong>ID Instans</strong> untuk setiap perangkat di halaman <a href="/devices">'Perangkat'</a>. Gunakan nilai <strong>ID Instans</strong> ini sebagai <code>deviceId</code> Anda.</p>
</div>

<!-- Send Text -->
<div class="card">
  <h2>Kirim Pesan Teks</h2>
  <p><span class="endpoint">POST /api/v1/message/send-text</span></p>
  <p>Badan permintaan harus berupa <code>application/json</code>.</p>

  <div class="tabs">
    <button class="tab-button active" data-tab="text-curl">cURL</button>
    <button class="tab-button" data-tab="text-php">PHP</button>
    <button class="tab-button" data-tab="text-js">JavaScript</button>
  </div>

  <div id="text-curl" class="tab-content active">
<pre><code>
curl -X POST 'https://xcd.xcreate.my.id/api/v1/message/send-text' \
--header 'x-api-key: KUNCI_API_ANDA' \
--header 'Content-Type: application/json' \
--data-raw '{
    "deviceId": "ID_INSTANS_PERANGKAT_ANDA",
    "to": "6281234567890",
    "message": "Halo dari Wapi XCD!"
}'
</code></pre>
  </div>
  <div id="text-php" class="tab-content">
<pre><code>
&lt;?php
$curl = curl_init();

curl_setopt_array($curl, array(
  CURLOPT_URL => 'https://xcd.xcreate.my.id/api/v1/message/send-text',
  CURLOPT_RETURNTRANSFER => true,
  CURLOPT_ENCODING => '',
  CURLOPT_MAXREDIRS => 10,
  CURLOPT_TIMEOUT => 0,
  CURLOPT_FOLLOWLOCATION => true,
  CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
  CURLOPT_CUSTOMREQUEST => 'POST',
  CURLOPT_POSTFIELDS => json_encode(array(
    'deviceId' => 'ID_INSTANS_PERANGKAT_ANDA',
    'to' => '6281234567890',
    'message' => 'Halo dari Wapi XCD!'
  )),
  CURLOPT_HTTPHEADER => array(
    'x-api-key: KUNCI_API_ANDA',
    'Content-Type: application/json'
  ),
));

$response = curl_exec($curl);
curl_close($curl);
echo $response;
?&gt;
</code></pre>
  </div>
  <div id="text-js" class="tab-content">
<pre><code>
const axios = require('axios');
const data = JSON.stringify({
  "deviceId": "ID_INSTANS_PERANGKAT_ANDA",
  "to": "6281234567890",
  "message": "Halo dari Wapi XCD!"
});

const config = {
  method: 'post',
  url: 'https://xcd.xcreate.my.id/api/v1/message/send-text',
  headers: {
    'x-api-key': 'KUNCI_API_ANDA',
    'Content-Type': 'application/json'
  },
  data : data
};

axios(config)
.then(function (response) {
  console.log(JSON.stringify(response.data));
})
.catch(function (error) {
  console.log(error);
});
</code></pre>
  </div>
</div>

<!-- Send Media -->
<div class="card">
  <h2>Kirim Pesan Media</h2>
  <p><span class="endpoint">POST /api/v1/message/send-image</span> atau <span class="endpoint">POST /api/v1/message/send-document</span></p>
  <p>Permintaan harus dikirim sebagai <code>multipart/form-data</code>.</p>

  <div class="tabs">
    <button class="tab-button active" data-tab="media-curl">cURL</button>
    <button class="tab-button" data-tab="media-php">PHP</button>
    <button class="tab-button" data-tab="media-js">JavaScript</button>
  </div>

  <div id="media-curl" class="tab-content active">
<pre><code>
curl --location --request POST 'https://xcd.xcreate.my.id/api/v1/message/send-image' \
--header 'x-api-key: KUNCI_API_ANDA' \
--form 'deviceId="ID_INSTANS_PERANGKAT_ANDA"' \
--form 'to="6281234567890"' \
--form 'message="Ini adalah caption gambar."' \
--form 'file=@"/path/to/your/image.jpg"'
</code></pre>
  </div>
  <div id="media-php" class="tab-content">
<pre><code>
&lt;?php
$curl = curl_init();

curl_setopt_array($curl, array(
  CURLOPT_URL => 'https://xcd.xcreate.my.id/api/v1/message/send-image',
  CURLOPT_RETURNTRANSFER => true,
  CURLOPT_ENCODING => '',
  CURLOPT_MAXREDIRS => 10,
  CURLOPT_TIMEOUT => 0,
  CURLOPT_FOLLOWLOCATION => true,
  CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
  CURLOPT_CUSTOMREQUEST => 'POST',
  CURLOPT_POSTFIELDS => array(
    'deviceId' => 'ID_INSTANS_PERANGKAT_ANDA',
    'to' => '6281234567890',
    'message' => 'Ini adalah caption gambar.',
    'file'=> new CURLFILE('/path/to/your/image.jpg')
  ),
  CURLOPT_HTTPHEADER => array(
    'x-api-key: KUNCI_API_ANDA'
  ),
));

$response = curl_exec($curl);
curl_close($curl);
echo $response;
?&gt;
</code></pre>
  </div>
  <div id="media-js" class="tab-content">
<pre><code>
const axios = require('axios');
const FormData = require('form-data');
const fs = require('fs');
const data = new FormData();
data.append('deviceId', 'ID_INSTANS_PERANGKAT_ANDA');
data.append('to', '6281234567890');
data.append('message', 'Ini adalah caption gambar.');
data.append('file', fs.createReadStream('/path/to/your/image.jpg'));

const config = {
  method: 'post',
  url: 'https://xcd.xcreate.my.id/api/v1/message/send-image',
  headers: {
    'x-api-key': 'KUNCI_API_ANDA',
    ...data.getHeaders()
  },
  data : data
};

axios(config)
.then(function (response) {
  console.log(JSON.stringify(response.data));
})
.catch(function (error) {
  console.log(error);
});
</code></pre>
  </div>
</div>

<%- include('partials/footer') %>
