<%- include('partials/header', { title: 'Manajemen Bot', active: 'bot' }) %>

<div class="header">
  <h1>Manajemen Bot</h1>
  <button id="add-bot-btn" class="btn">Tambah Bot Baru</button>
</div>

<% if (bots.length > 0) { %>
  <% bots.forEach(bot => { %>
    <div class="bot-container card">
      <div class="bot-header">
        <h2><%= bot.name %> <small>(Perangkat: <%= bot.device.remark %>)</small></h2>
        <form action="/api/v1/bot/delete/<%= bot.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin?');">
          <button type="submit" class="btn btn-danger">Hapus Bot</button>
        </form>
      </div>
      <div class="bot-body">
        <% bot.triggers.forEach(trigger => { %>
          <div class="trigger-card">
            <div class="trigger-header">
              <span>Pemicu: <code><%= trigger.keyword %></code> (Tipe: <%= trigger.matchType %>)</span>
              <form action="/api/v1/bot/trigger/delete/<%= trigger.id %>" method="POST">
                <button type="submit" class="btn btn-danger btn-sm">Hapus Pemicu</button>
              </form>
            </div>
            <div class="trigger-body">
              <% trigger.actions.forEach(action => { %>
                <div class="action-item">
                  <span>Tindakan: <%= action.actionType %></span>
                  <form action="/api/v1/bot/action/delete/<%= action.id %>" method="POST">
                    <button type="submit" class="btn btn-danger btn-sm">Hapus Tindakan</button>
                  </form>
                </div>
              <% }); %>
              <button class="btn btn-secondary btn-sm add-action-btn" data-trigger-id="<%= trigger.id %>">Tambah Tindakan</button>
            </div>
          </div>
        <% }); %>
        <button class="btn btn-primary add-trigger-btn" data-bot-id="<%= bot.id %>">Tambah Pemicu</button>
      </div>
    </div>
  <% }); %>
<% } else { %>
  <div class="card text-center">
    <p>Bot tidak ditemukan. Klik "Tambah Bot Baru" untuk memulai.</p>
  </div>
<% } %>

<!-- Modals -->
<div id="add-bot-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Tambah Bot Baru</h2>
      <span class="close-btn">&times;</span>
    </div>
    <form action="/api/v1/bot/create" method="POST">
      <div class="form-group">
        <label for="bot-name">Nama Bot</label>
        <input type="text" name="name" id="bot-name" required>
      </div>
      <div class="form-group">
        <label for="bot-device">Perangkat</label>
        <select name="deviceId" id="bot-device" required>
          <% devices.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.remark %></option>
          <% }); %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Buat Bot</button>
    </form>
  </div>
</div>

<div id="add-trigger-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Tambah Pemicu</h2>
      <span class="close-btn">&times;</span>
    </div>
    <form action="/api/v1/bot/trigger/create" method="POST">
      <input type="hidden" name="botId" id="trigger-bot-id">
      <div class="form-group">
        <label for="trigger-keyword">Kata Kunci</label>
        <input type="text" name="keyword" id="trigger-keyword" required>
      </div>
      <div class="form-group">
        <label for="trigger-match-type">Tipe Pencocokan</label>
        <select name="matchType" id="trigger-match-type">
          <option value="exact">Persis</option>
          <option value="contains">Mengandung</option>
          <option value="startsWith">Dimulai Dengan</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Buat Pemicu</button>
    </form>
  </div>
</div>

<div id="add-action-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Tambah Tindakan</h2>
      <span class="close-btn">&times;</span>
    </div>
    <form action="/api/v1/bot/action/create" method="POST" id="action-form">
      <input type="hidden" name="triggerId" id="action-trigger-id">
      <input type="hidden" name="payload" id="action-payload">
      <div class="form-group">
        <label for="action-type">Tipe Tindakan</label>
        <select name="actionType" id="action-type">
          <option value="reply">Balas</option>
          <option value="webhook">Webhook</option>
        </select>
      </div>
      <div id="reply-fields">
        <div class="form-group">
          <label for="reply-text">Teks Balasan</label>
          <textarea id="reply-text"></textarea>
        </div>
        <div class="form-group">
          <label for="reply-media">URL Media (Opsional)</label>
          <input type="text" id="reply-media">
        </div>
      </div>
      <div id="webhook-fields" style="display: none;">
        <div class="form-group">
          <label for="webhook-url">URL Webhook</label>
          <input type="url" id="webhook-url">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Buat Tindakan</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
