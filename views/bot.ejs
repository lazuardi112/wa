<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Bot</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1, h2 { color: #007bff; }
        .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; margin-bottom: 0.5rem; }
        input, select, textarea { width: 100%; max-width: 500px; padding: 0.75rem; border-radius: 4px; border: 1px solid #333; background: #2c2c2c; color: white; box-sizing: border-box; }
        textarea { min-height: 100px; }
        button, .btn { padding: 0.75rem 1.5rem; border: none; border-radius: 4px; background-color: #007bff; color: white; font-size: 1rem; cursor: pointer; text-decoration: none; display: inline-block; }
        .btn-danger { background-color: #dc3545; }
        .btn-toggle { background-color: #6c757d; }
        table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
        th, td { padding: 1rem; text-align: left; border-bottom: 1px solid #333; }
        th { background-color: #2c2c2c; }
    </style>
</head>
<body>
    <%- include('partials/sidebar', { active: 'bot' }) %>
    <div class="main-content">
        <h1>WhatsApp Bot</h1>

        <div class="card">
            <h2>Create New Bot Flow</h2>
            <form action="/api/v1/bot/create" method="POST">
                <div class="form-group">
                    <label for="deviceId">Select Device</label>
                    <select id="deviceId" name="deviceId" required>
                        <% devices.forEach(device => { %>
                            <option value="<%= device.id %>" <%= device.status !== 'connected' ? 'disabled' : '' %>>
                                <%= device.id %> (Status: <%= device.status %>)
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="prefix">Prefix (Trigger Keyword)</label>
                    <input type="text" id="prefix" name="prefix" placeholder="e.g., !menu" required>
                </div>
                <div class="form-group">
                    <label for="response">Response</label>
                    <textarea id="response" name="response" placeholder="The bot's automated reply." required></textarea>
                </div>
                <div class="form-group">
                    <label for="mediaUrl">Media URL (Optional)</label>
                    <input type="text" id="mediaUrl" name="mediaUrl" placeholder="https://example.com/image.jpg">
                    <small>If provided, the bot will send this image with the response as its caption.</small>
                </div>
                <div class="form-group">
                    <label for="parentId">Parent Flow (for branching)</label>
                    <select id="parentId" name="parentId">
                        <option value="">None (Top-level flow)</option>
                        <% botFlows.forEach(flow => { %>
                            <% if (!flow.parentId) { %>
                                <option value="<%= flow.id %>"><%= flow.prefix %></option>
                            <% } %>
                        <% }); %>
                    </select>
                </div>
                <button type="submit">Create Flow</button>
            </form>
        </div>

        <div class="card">
            <h2>Manage Bot Flows</h2>
            <table>
                <thead>
                    <tr>
                        <th>Prefix</th>
                        <th>Response</th>
                        <th>Device</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <%
                        const renderFlows = (flows, parentId = null, level = 0) => {
                            const children = flows.filter(f => f.parentId === parentId);
                            if (children.length === 0) return;
                    %>
                    <% children.forEach(flow => { %>
                        <tr>
                            <td style="padding-left: <%= 1 + level * 1.5 %>rem;">
                                <% if (level > 0) { %><span>&#8627;</span><% } %>
                                <%= flow.prefix %>
                            </td>
                            <td><%= flow.response.substring(0, 50) %>...</td>
                            <td><%= flow.deviceId %></td>
                            <td><%= flow.isEnabled ? 'Active' : 'Inactive' %></td>
                            <td>
                                <form action="/api/v1/bot/toggle/<%= flow.id %>" method="POST" style="display: inline;">
                                    <button type="submit" class="btn btn-toggle"><%= flow.isEnabled ? 'Disable' : 'Enable' %></button>
                                </form>
                                <a href="/bot/edit/<%= flow.id %>" class="btn">Edit</a>
                                <form action="/api/v1/bot/delete/<%= flow.id %>" method="POST" style="display: inline;">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                        <% renderFlows(flows, flow.id, level + 1); %>
                    <% }); %>
                    <% }; %>

                    <% if (botFlows && botFlows.length > 0) { %>
                        <% renderFlows(botFlows); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center;">No bot flows found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
