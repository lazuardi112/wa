<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Send Message</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1 { color: #007bff; }
        .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; margin-top: 2rem; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; margin-bottom: 0.5rem; }
        input, select, textarea { width: 100%; max-width: 500px; padding: 0.75rem; border-radius: 4px; border: 1px solid #333; background: #2c2c2c; color: white; box-sizing: border-box; }
        input[type="radio"] { width: auto; }
        textarea { min-height: 120px; }
        button { padding: 0.75rem 1.5rem; border: none; border-radius: 4px; background-color: #007bff; color: white; font-size: 1rem; cursor: pointer; }
        .hidden { display: none; }
    </style>
</head>
<body>
    <%- include('partials/sidebar', { active: 'messaging' }) %>
    <div class="main-content">
        <h1>Send New Message</h1>
        <div class="card">
            <form action="/api/v1/message/send" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="deviceId">Select Device</label>
                    <select id="deviceId" name="deviceId" required>
                        <% devices.forEach(device => { %>
                            <option value="<%= device.id %>" <%= device.status !== 'connected' ? 'disabled' : '' %>>
                                <%= device.id %> (Status: <%= device.status %>)
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="numbers">Recipient Number(s)</label>
                    <input type="text" id="numbers" name="numbers" placeholder="628123..., 628567..." required>
                    <small>For multiple numbers, separate with a comma.</small>
                </div>
                <div class="form-group">
                    <label>Message Type</label>
                    <input type="radio" id="type_text" name="messageType" value="text" checked>
                    <label for="type_text" style="display: inline-block;">Text</label>
                    <input type="radio" id="type_media" name="messageType" value="media">
                    <label for="type_media" style="display: inline-block;">Image/Document</label>
                </div>

                <div id="media-upload" class="form-group hidden">
                    <label for="media">Upload Media</label>
                    <input type="file" id="media" name="media" accept="image/*,application/pdf">
                    <small>Upload an image (JPG, PNG) or a document (PDF).</small>
                </div>

                <div class="form-group">
                    <label id="message-label" for="message">Message</label>
                    <textarea id="message" name="message" required></textarea>
                    <small id="message-hint">Enter your text message here.</small>
                </div>
                <button type="submit">Send Message</button>
            </form>
        </div>
    </div>

    <script>
        const messageTypeRadios = document.querySelectorAll('input[name="messageType"]');
        const mediaUploadDiv = document.getElementById('media-upload');
        const messageLabel = document.getElementById('message-label');
        const messageHint = document.getElementById('message-hint');
        const messageTextarea = document.getElementById('message');
        const mediaInput = document.getElementById('media');

        messageTypeRadios.forEach(radio => {
            radio.addEventListener('change', (event) => {
                if (event.target.value === 'media') {
                    mediaUploadDiv.classList.remove('hidden');
                    messageLabel.textContent = 'Caption (Optional)';
                    messageHint.textContent = 'Enter a caption for your media file.';
                    messageTextarea.required = false;
                    mediaInput.required = true;
                } else {
                    mediaUploadDiv.classList.add('hidden');
                    messageLabel.textContent = 'Message';
                    messageHint.textContent = 'Enter your text message here.';
                    messageTextarea.required = true;
                    mediaInput.required = false;
                }
            });
        });
    </script>
</body>
</html>
