<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Send Message</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1 { color: #007bff; }
        .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; margin-top: 2rem; }
        .tabs { display: flex; border-bottom: 2px solid #333; }
        .tab-button { background: none; border: none; color: white; padding: 1rem 1.5rem; cursor: pointer; font-size: 1rem; border-bottom: 2px solid transparent; }
        .tab-button.active { color: #007bff; border-bottom-color: #007bff; }
        .tab-content { display: none; padding-top: 1.5rem; }
        .tab-content.active { display: block; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; margin-bottom: 0.5rem; }
        input, select, textarea { width: 100%; max-width: 500px; padding: 0.75rem; border-radius: 4px; border: 1px solid #333; background: #2c2c2c; color: white; box-sizing: border-box; }
        textarea { min-height: 120px; }
        button { padding: 0.75rem 1.5rem; border: none; border-radius: 4px; background-color: #007bff; color: white; font-size: 1rem; cursor: pointer; }
    </style>
</head>
<body>
    <%- include('partials/sidebar', { active: 'messaging' }) %>
    <div class="main-content">
        <% if (locals.query && query.status === 'error' && query.msg && query.msg.includes('limit')) { %>
            <div class="card" style="background-color: #dc3545; margin-bottom: 1.5rem;">
                <h3 style="margin-top: 0;">Message Limit Reached</h3>
                <p><%= query.msg %></p>
                <a href="/subscribe" style="background-color: #28a745; color: white; padding: 0.75rem 1.5rem; border-radius: 4px; text-decoration: none; display: inline-block;">Upgrade Plan</a>
            </div>
        <% } %>
        <h1>Send New Message</h1>
        <div class="card">
            <div class="tabs">
                <button class="tab-button active" data-tab="text">Text Message</button>
                <button class="tab-button" data-tab="media">Media Message</button>
                <button class="tab-button" data-tab="bulk">Bulk Messaging</button>
            </div>

            <!-- Text Message Tab -->
            <div id="text" class="tab-content active">
                <form action="/api/v1/message/send" method="POST">
                    <input type="hidden" name="messageType" value="text">
                    <div class="form-group">
                        <label for="deviceId_text">Select Device</label>
                        <select id="deviceId_text" name="deviceId" required>
                            <% devices.forEach(device => { %>
                                <option value="<%= device.id %>" <%= device.status !== 'connected' ? 'disabled' : '' %>>
                                    <%= device.id %> (Status: <%= device.status %>)
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="numbers_text">Recipient Number</label>
                        <input type="text" id="numbers_text" name="numbers" placeholder="628123..." required>
                    </div>
                    <div class="form-group">
                        <label for="message_text">Message</label>
                        <textarea id="message_text" name="message" required></textarea>
                    </div>
                    <button type="submit">Send Message</button>
                </form>
            </div>

            <!-- Media Message Tab -->
            <div id="media" class="tab-content">
                <form action="/api/v1/message/send" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="messageType" value="media">
                    <div class="form-group">
                        <label for="deviceId_media">Select Device</label>
                        <select id="deviceId_media" name="deviceId" required>
                            <% devices.forEach(device => { %>
                                <option value="<%= device.id %>" <%= device.status !== 'connected' ? 'disabled' : '' %>>
                                    <%= device.id %> (Status: <%= device.status %>)
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="numbers_media">Recipient Number</label>
                        <input type="text" id="numbers_media" name="numbers" placeholder="628123..." required>
                    </div>
                    <div class="form-group">
                        <label for="media_file">Upload Media</label>
                        <input type="file" id="media_file" name="media" accept="image/*,application/pdf" required>
                    </div>
                    <div class="form-group">
                        <label for="caption_media">Caption (Optional)</label>
                        <textarea id="caption_media" name="message"></textarea>
                    </div>
                    <button type="submit">Send Media</button>
                </form>
            </div>

            <!-- Bulk Messaging Tab -->
            <div id="bulk" class="tab-content">
                <form action="/api/v1/message/send" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="deviceId_bulk">Select Device</label>
                        <select id="deviceId_bulk" name="deviceId" required>
                            <% devices.forEach(device => { %>
                                <option value="<%= device.id %>" <%= device.status !== 'connected' ? 'disabled' : '' %>>
                                    <%= device.id %> (Status: <%= device.status %>)
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="numbers_bulk">Recipient Numbers</label>
                        <textarea id="numbers_bulk" name="numbers" placeholder="628123...,&#10;628567...,&#10;628789..." required></textarea>
                        <small>Enter one number per line or separate with commas.</small>
                    </div>
                    <div class="form-group">
                        <label>Message Type</label>
                        <select name="messageType" onchange="toggleBulkMedia(this.value)">
                            <option value="text">Text</option>
                            <option value="media">Media</option>
                        </select>
                    </div>
                    <div id="bulk_media_upload" class="form-group" style="display: none;">
                        <label for="media_file_bulk">Upload Media</label>
                        <input type="file" id="media_file_bulk" name="media" accept="image/*,application/pdf">
                    </div>
                    <div class="form-group">
                        <label for="message_bulk">Message / Caption</label>
                        <textarea id="message_bulk" name="message" required></textarea>
                    </div>
                    <button type="submit">Send Bulk Message</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        const tabs = document.querySelectorAll('.tab-button');
        const contents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                contents.forEach(c => c.classList.remove('active'));

                tab.classList.add('active');
                document.getElementById(tab.dataset.tab).classList.add('active');
            });
        });

        function toggleBulkMedia(type) {
            const bulkMediaUpload = document.getElementById('bulk_media_upload');
            const bulkMediaInput = document.getElementById('media_file_bulk');
            if (type === 'media') {
                bulkMediaUpload.style.display = 'block';
                bulkMediaInput.required = true;
            } else {
                bulkMediaUpload.style.display = 'none';
                bulkMediaInput.required = false;
            }
        }
    </script>
</body>
</html>
