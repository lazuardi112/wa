<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Send Message</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1 { color: #007bff; }
        .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; margin-top: 2rem; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; margin-bottom: 0.5rem; }
        input, select, textarea { width: 100%; max-width: 500px; padding: 0.75rem; border-radius: 4px; border: 1px solid #333; background: #2c2c2c; color: white; box-sizing: border-box; }
        textarea { min-height: 120px; }
        button { padding: 0.75rem 1.5rem; border: none; border-radius: 4px; background-color: #007bff; color: white; font-size: 1rem; cursor: pointer; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Dashboard</h2>
        <a href="/dashboard">Overview</a>
        <a href="/devices">Devices</a>
        <a href="/messaging">Send Message</a>
        <a href="/bot">WhatsApp Bot</a>
        <a href="/api-docs">API Docs</a>
        <a href="/logout">Logout</a>
    </div>
    <div class="main-content">
        <h1>Send New Message</h1>
        <div class="card">
            <form action="/api/v1/message/send" method="POST">
                <div class="form-group">
                    <label for="deviceId">Select Device</label>
                    <select id="deviceId" name="deviceId" required>
                        <% devices.forEach(device => { %>
                            <option value="<%= device.id %>"><%= device.id %> (Status: <%= device.status %>)</option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="numbers">Recipient Number(s)</label>
                    <input type="text" id="numbers" name="numbers" placeholder="628123..., 628567..." required>
                    <small>For multiple numbers, separate with a comma.</small>
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" required></textarea>
                    <small>To send an image or document, paste the direct URL here.</small>
                </div>
                <button type="submit">Send Message</button>
            </form>
        </div>
    </div>
</body>
</html>
