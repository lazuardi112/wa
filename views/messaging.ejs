<%- include('partials/header', { title: 'Kirim Pesan', active: 'messaging' }) %>

<div class="header">
  <h1>Kirim Pesan Baru</h1>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>
<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<div class="card">
  <div class="tabs">
    <button class="tab-button active" data-tab="text">Pesan Teks</button>
    <button class="tab-button" data-tab="media">Pesan Media</button>
    <button class="tab-button" data-tab="bulk">Pesan Massal</button>
  </div>

  <div class="tab-content active" id="text">
    <form action="/api/v1/message/send" method="POST">
      <input type="hidden" name="messageType" value="text">
      <div class="form-group">
        <label for="deviceId_text">Pilih Perangkat</label>
        <select id="deviceId_text" name="deviceId" required>
          <% devices.forEach(device => { %>
            <option value="<%= device.id %>" <%= device.status !== 'connected' ? 'disabled' : '' %>>
              <%= device.remark %> (Status: <%= device.status %>)
            </option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label for="numbers_text">Nomor Penerima</label>
        <input type="text" id="numbers_text" name="numbers" placeholder="628123..." required>
      </div>
      <div class="form-group">
        <label for="message_text">Pesan</label>
        <textarea id="message_text" name="message" required></textarea>
      </div>
      <button type="submit" class="btn">Kirim Pesan</button>
    </form>
  </div>

  <div class="tab-content" id="media">
    <form action="/api/v1/message/send" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="messageType" value="media">
       <div class="form-group">
        <label for="deviceId_media">Pilih Perangkat</label>
        <select id="deviceId_media" name="deviceId" required>
          <% devices.forEach(device => { %>
            <option value="<%= device.id %>" <%= device.status !== 'connected' ? 'disabled' : '' %>>
              <%= device.remark %> (Status: <%= device.status %>)
            </option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label for="numbers_media">Nomor Penerima</label>
        <input type="text" id="numbers_media" name="numbers" placeholder="628123..." required>
      </div>
      <div class="form-group">
        <label for="media_file">Unggah Media</label>
        <input type="file" id="media_file" name="media" accept="image/*,application/pdf" required>
      </div>
      <div class="form-group">
        <label for="caption_media">Keterangan (Opsional)</label>
        <textarea id="caption_media" name="message"></textarea>
      </div>
      <button type="submit" class="btn">Kirim Media</button>
    </form>
  </div>

  <div class="tab-content" id="bulk">
    <form action="/api/v1/message/send" method="POST" enctype="multipart/form-data">
       <div class="form-group">
        <label for="deviceId_bulk">Pilih Perangkat</label>
        <select id="deviceId_bulk" name="deviceId" required>
          <% devices.forEach(device => { %>
            <option value="<%= device.id %>" <%= device.status !== 'connected' ? 'disabled' : '' %>>
              <%= device.remark %> (Status: <%= device.status %>)
            </option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label for="numbers_bulk">Nomor Penerima</label>
        <textarea id="numbers_bulk" name="numbers" placeholder="628123...,&#10;628567...,&#10;628789..." required></textarea>
        <small>Masukkan satu nomor per baris atau pisahkan dengan koma.</small>
      </div>
      <div class="form-group">
        <label>Tipe Pesan</label>
        <select name="messageType" onchange="toggleBulkMedia(this.value)">
          <option value="text">Teks</option>
          <option value="media">Media</option>
        </select>
      </div>
      <div id="bulk_media_upload" class="form-group" style="display: none;">
        <label for="media_file_bulk">Unggah Media</label>
        <input type="file" id="media_file_bulk" name="media" accept="image/*,application/pdf">
      </div>
      <div class="form-group">
        <label for="message_bulk">Pesan / Keterangan</label>
        <textarea id="message_bulk" name="message" required></textarea>
      </div>
      <button type="submit" class="btn">Kirim Pesan Massal</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
