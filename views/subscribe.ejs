<%- include('partials/header', { title: 'Langganan', active: 'subscribe' }) %>

<style>
  .header h1 {
    text-align: center;
    margin-top: 30px;
    font-weight: 700;
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    padding: 30px;
  }

  .package-card {
    background: #ffffff;
    padding: 20px;
    border-radius: 15px;
    border: 1px solid #eee;
    box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    transition: 0.3s;
  }

  .package-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.12);
  }

  .package-card.current {
    border: 2px solid #2D8CFF;
    box-shadow: 0 6px 18px rgba(45,140,255,0.25);
  }

  .price {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #2D8CFF;
  }

  .btn-upgrade {
    width: 100%;
    padding: 12px;
    margin-top: 15px;
    background: #2D8CFF;
    border: none;
    color: #fff;
    border-radius: 10px;
    font-size: 15px;
    cursor: pointer;
    transition: 0.3s;
  }

  .btn-upgrade:hover {
    background: #1d6fd1;
  }

  /* ----- MODAL STYLE ----- */
  .modal {
    display: none; 
    position: fixed;
    z-index: 999999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    backdrop-filter: blur(4px);
    background: rgba(0,0,0,0.4);
  }

  .modal-content {
    background: #fff;
    margin: 120px auto;
    padding: 20px;
    width: 95%;
    max-width: 420px;
    border-radius: 16px;
    animation: fadeIn 0.3s ease-out;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .close-btn {
    cursor: pointer;
    font-size: 28px;
    font-weight: 600;
    color: #666;
  }

  #qr-code-image {
    width: 100%;
    max-width: 260px;
    display: block;
    margin: 20px auto;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 480px) {
    .modal-content {
      margin-top: 80px;
      width: 90%;
    }
  }

</style>

<div class="header">
  <h1>Paket Langganan</h1>
</div>

<div class="packages-grid">
  <% if (packages && packages.length > 0) { %>
    <% packages.forEach(pkg => { %>
      <div class="card package-card <%= currentPackage.id === pkg.id ? 'current' : '' %>">

        <h2><%= pkg.name %></h2>
        <div class="price">IDR <%= pkg.price.toLocaleString() %> / bulan</div>

        <ul>
          <li><strong><%= pkg.maxDevices %></strong> Perangkat</li>
          <li><strong><%= pkg.messageLimit.toLocaleString() %></strong> Pesan/Hari</li>
          <li>Akses API: <strong><%= pkg.apiAccess ? 'Ya' : 'Tidak' %></strong></li>
          <li>Durasi: <strong><%= pkg.durationDays %></strong> Hari</li>
        </ul>

        <% if (currentPackage.id !== pkg.id && pkg.name !== 'Free') { %>
          <div class="form-group" style="margin-top: 1rem;">
            <label for="months-<%= pkg.id %>">Bulan:</label>
            <input type="number" id="months-<%= pkg.id %>" value="1" min="1" max="12" class="form-control">
          </div>

          <button class="btn-upgrade" data-package-id="<%= pkg.id %>">
            Tingkatkan ke Premium
          </button>

          <div id="payment-error-<%= pkg.id %>" class="payment-error"></div>

        <% } else if (currentPackage.id === pkg.id) { %>
          <p><strong>(Paket Saat Ini)</strong></p>
        <% } %>

      </div>
    <% }); %>
  <% } else { %>
    <p>Saat ini tidak ada paket langganan yang tersedia.</p>
  <% } %>
</div>

<!-- ---------- MODAL QRIS ---------- -->
<div id="qr-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Pindai QRIS</h2>
      <span class="close-btn" id="close-qr-modal">&times;</span>
    </div>

    <div class="modal-body">
      <p style="text-align:center;">Gunakan aplikasi e-wallet Anda untuk membayar.</p>

      <img id="qr-code-image" src="" alt="QR Code">

      <p style="text-align:center;color:#444;margin-top:10px;">
        Setelah pembayaran, langganan Anda akan ter-update otomatis.
      </p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>