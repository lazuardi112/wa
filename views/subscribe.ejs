<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscribe</title>
    <!-- Use environment variable for Midtrans URL -->
    <script type="text/javascript"
      src="https://app.sandbox.midtrans.com/snap/snap.js"
      data-client-key="<%= midtransClientKey %>"></script>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1 { color: #007bff; }
        .packages { display: flex; gap: 2rem; justify-content: center; margin-top: 2rem; }
        .package-card { background: #1e1e1e; padding: 2rem; border-radius: 8px; text-align: center; width: 250px; }
        .package-card h2 { color: #007bff; margin-top: 0; }
        .package-card.current { border: 2px solid #007bff; }
        .price { font-size: 2rem; font-weight: bold; margin: 1rem 0; }
        ul { list-style: none; padding: 0; text-align: left; }
        li { margin-bottom: 0.5rem; }
        .btn-upgrade { background-color: #28a745; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; margin-top: 1.5rem; }
    </style>
</head>
<body>
    <%- include('partials/sidebar', { active: 'subscribe' }) %>
    <div class="main-content">
        <h1>Subscription Plans</h1>
        <div class="packages">
            <% packages.forEach(pkg => { %>
                <div class="package-card <%= currentPackage.id === pkg.id ? 'current' : '' %>">
                    <h2><%= pkg.name %></h2>
                    <div class="price">IDR <%= pkg.price.toLocaleString() %></div>
                    <ul>
                        <li><strong><%= pkg.maxDevices %></strong> Device(s)</li>
                        <li><strong><%= pkg.messageLimit.toLocaleString() %></strong> Messages/Day</li>
                        <li>API Access: <strong><%= pkg.apiAccess ? 'Yes' : 'No' %></strong></li>
                        <li>Duration: <strong><%= pkg.durationDays %></strong> Days</li>
                    </ul>
                    <% if (currentPackage.id !== pkg.id) { %>
                        <button class="btn-upgrade" onclick="pay('<%= pkg.id %>')">
                            <%= currentPackage.price < pkg.price ? 'Upgrade' : 'Downgrade' %>
                        </button>
                    <% } else { %>
                        <p><strong>(Current Plan)</strong></p>
                    <% } %>
                </div>
            <% }); %>
        </div>
    </div>

    <script type="text/javascript">
        async function pay(packageId) {
            try {
                const response = await fetch(`/api/v1/payment/subscribe/\${packageId}`, { method: 'POST' });
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.message || 'Failed to initiate payment');
                }
                const data = await response.json();

                window.snap.pay(data.token, {
                    onSuccess: function(result){
                        alert("Payment success!");
                        window.location.href = '/dashboard';
                    },
                    onPending: function(result){
                        alert("Waiting for your payment!");
                    },
                    onError: function(result){
                        alert("Payment failed!");
                    },
                    onClose: function(){
                        alert('You closed the popup without finishing the payment.');
                    }
                });
            } catch (error) {
                console.error('Payment error:', error);
                alert(`An error occurred: \${error.message}`);
            }
        }
    </script>
</body>
</html>
