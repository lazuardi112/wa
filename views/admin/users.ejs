<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #1a1a2e; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #16213e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #e94560; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #1f4068; }
        .main-content { margin-left: 270px; padding: 2rem; }
        .card { background: #16213e; padding: 1.5rem; border-radius: 8px; }
        h1 { color: #e94560; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        th, td { padding: 1rem; text-align: left; border-bottom: 1px solid #1f4068; }
        th { color: #e94560; }
        .action-btn { padding: 0.5rem 1rem; border: none; border-radius: 4px; color: white; cursor: pointer; }
        .btn-block { background-color: #dc3545; }
        .btn-unblock { background-color: #28a745; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Admin Panel</h2>
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/settings">Settings</a>
        <a href="/admin/users">User Management</a>
        <a href="/logout">Logout</a>
    </div>
    <div class="main-content">
        <h1>User Management</h1>
        <div class="card">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>WhatsApp</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.name %></td>
                            <td><%= user.email %></td>
                            <td><%= user.whatsappNumber %></td>
                            <td><%= user.isBlocked ? 'Blocked' : 'Active' %></td>
                            <td>
                                <form action="/api/v1/admin/users/<%= user.id %>/toggle-block" method="POST" style="display:inline;">
                                    <% if (user.isBlocked) { %>
                                        <button type="submit" class="action-btn btn-unblock">Unblock</button>
                                    <% } else { %>
                                        <button type="submit" class="action-btn btn-block">Block</button>
                                    <% } %>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
