<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1 { color: #007bff; }
        .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
        th, td { padding: 1rem; text-align: left; border-bottom: 1px solid #333; }
        th { background-color: #2c2c2c; }
        .btn { padding: 0.5rem 1rem; border: none; border-radius: 4px; color: white; text-decoration: none; cursor: pointer; }
        .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.875rem; }
        .btn-primary { background-color: #007bff; }
        .btn-danger { background-color: #dc3545; }
    </style>
</head>
<body>
    <%- include('sidebar') %>
    <div class="main-content">
        <h1>User Management</h1>
        <div class="card">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.id %></td>
                            <td><%= user.name %></td>
                            <td><%= user.email %></td>
                            <td>
                                <% if (user.isBlocked) { %>
                                    <span style="color: #dc3545;">Blocked</span>
                                <% } else { %>
                                    <span style="color: #28a745;">Active</span>
                                <% } %>
                            </td>
                            <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                            <td>
                                <a href="/admin/users/edit/<%= user.id %>" class="btn btn-sm btn-primary">Edit</a>
                                <form action="/api/v1/admin/users/delete/<%= user.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>

                                <form action="/api/v1/admin/users/<%= user.id %>/toggle-block" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-sm <%= user.isBlocked ? 'btn-primary' : 'btn-danger' %>">
                                        <%= user.isBlocked ? 'Unblock' : 'Block' %>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
