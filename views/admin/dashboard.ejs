<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1 { color: #007bff; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
        .stat-card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; }
        .stat-card h3 { margin-top: 0; color: #6c757d; }
        .stat-card .value { font-size: 2.5rem; font-weight: bold; color: #007bff; }
    </style>
</head>
<body>
    <%- include('sidebar') %>
    <div class="main-content">
        <h1>Admin Dashboard</h1>
        <div class="stats-grid">
            <div class="stat-card">
                <h3>Total Users</h3>
                <div class="value"><%= stats.totalUsers %></div>
            </div>
            <div class="stat-card">
                <h3>Total Revenue</h3>
                <div class="value">IDR <%= stats.totalRevenue.toLocaleString() %></div>
            </div>
            <div class="stat-card">
                <h3>Connected Devices</h3>
                <div class="value"><%= stats.connectedDevices %></div>
            </div>
            <div class="stat-card">
                <h3>Successful Transactions</h3>
                <div class="value"><%= stats.successfulTransactions %></div>
            </div>
        </div>
    </div>
</body>
</html>
