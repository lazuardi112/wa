<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Settings</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1, h2 { color: #007bff; }
        .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; margin-bottom: 0.5rem; }
        input, select { width: 100%; max-width: 600px; padding: 0.75rem; border-radius: 4px; border: 1px solid #333; background: #2c2c2c; color: white; box-sizing: border-box; }
        button { padding: 0.75rem 1.5rem; border: none; border-radius: 4px; background-color: #007bff; color: white; font-size: 1rem; cursor: pointer; }
        .message { background-color: #28a745; color: white; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <%- include('sidebar') %>
    <div class="main-content">
        <h1>System Settings</h1>

        <% if (message) { %>
            <div class="message"><%= message %></div>
        <% } %>

        <div class="card">
            <h2>Midtrans Payment Gateway</h2>
            <form action="/api/v1/admin/settings" method="POST">
                <div class="form-group">
                    <label for="midtransEnv">Environment</label>
                    <select id="midtransEnv" name="midtransEnv">
                        <option value="sandbox" <%= settings.midtransEnv === 'sandbox' ? 'selected' : '' %>>Sandbox</option>
                        <option value="production" <%= settings.midtransEnv === 'production' ? 'selected' : '' %>>Production</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="midtransServerKey">Server Key</label>
                    <input type="text" id="midtransServerKey" name="midtransServerKey" value="<%= settings.midtransServerKey %>">
                </div>
                <div class="form-group">
                    <label for="midtransClientKey">Client Key</label>
                    <input type="text" id="midtransClientKey" name="midtransClientKey" value="<%= settings.midtransClientKey %>">
                </div>
                <div class="form-group">
                    <label for="midtransNotificationUrl">Notification URL (Override)</label>
                    <input type="text" id="midtransNotificationUrl" name="midtransNotificationUrl" value="<%= settings.midtransNotificationUrl %>" placeholder="Optional: leave blank to use default">
                </div>
                <button type="submit">Save Midtrans Settings</button>
            </form>
        </div>

        <div class="card">
            <h2>System Devices</h2>
            <form action="/api/v1/admin/settings/otp-device" method="POST">
                <div class="form-group">
                    <label for="otpDeviceId">Global OTP Device</label>
                    <select id="otpDeviceId" name="otpDeviceId" required>
                        <option value="">Select a device...</option>
                        <% allDevices.forEach(device => { %>
                            <option value="<%= device.id %>" <%= settings.otpDeviceId == device.id ? 'selected' : '' %>>
                                ID: <%= device.id %> | Remark: <%= device.remark %> | User: <%= userMap[device.userId] || 'N/A' %>
                            </option>
                        <% }); %>
                    </select>
                    <small>This device will be used to send all OTP messages for new user registrations.</small>
                </div>
                <button type="submit">Save OTP Device</button>
            </form>
        </div>
    </div>
</body>
</html>
