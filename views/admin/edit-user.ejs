<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1 { color: #007bff; }
        .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; margin-bottom: 0.5rem; }
        input, select, .form-control { width: 100%; max-width: 600px; padding: 0.75rem; border-radius: 4px; border: 1px solid #333; background: #2c2c2c; color: white; box-sizing: border-box; }
        .btn { padding: 0.75rem 1.5rem; border: none; border-radius: 4px; color: white; text-decoration: none; cursor: pointer; display: inline-block; }
        .btn-primary { background-color: #007bff; }
        .btn-secondary { background-color: #6c757d; }
        .mt-3 { margin-top: 1rem; }
    </style>
</head>
<body>
    <%- include('sidebar') %>
    <div class="main-content">
        <h1>Edit Pengguna</h1>

        <% if (query && query.error) { %>
            <div style="padding: 1rem; margin-bottom: 1rem; border-radius: 4px; background-color: #dc3545;"><%= query.error %></div>
        <% } %>

        <div class="card">
            <form action="/api/v1/admin/users/edit/<%= userToEdit.id %>" method="POST">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= userToEdit.email %>" required>
                </div>
                <div class="form-group">
                    <label for="name">Nama</label>
                    <input type="text" class="form-control" id="name" name="name" value="<%= userToEdit.name %>" required>
                </div>
                <div class="form-group">
                    <label for="phone">Telepon</label>
                    <input type="text" class="form-control" id="phone" name="phone" value="<%= userToEdit.phone %>">
                </div>
                 <div class="form-group">
                    <label for="messageLimit">Batas Pesan Harian</label>
                    <input type="number" class="form-control" id="messageLimit" name="messageLimit" value="<%= userToEdit.messageLimit %>" required>
                </div>
                <div class="form-group">
                    <label for="packageId">Paket</label>
                    <select class="form-control" id="packageId" name="packageId">
                        <% packages.forEach(pkg => { %>
                            <option value="<%= pkg.id %>" <%= userToEdit.packageId == pkg.id ? 'selected' : '' %>>
                                <%= pkg.name %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Blokir Pengguna</label>
                    <input type="checkbox" name="isBlocked" <%= userToEdit.isBlocked ? 'checked' : '' %>>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Simpan Perubahan</button>
                <a href="/admin/users" class="btn btn-secondary mt-3">Batal</a>
            </form>
        </div>
    </div>
</body>
</html>
