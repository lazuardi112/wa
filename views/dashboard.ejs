<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Dashboard</title>
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #0f0f0f;
      color: #e5e5e5;
      margin: 0;
      display: flex;
    }

    .sidebar {
      width: 260px;
      height: 100vh;
      background: #151515;
      padding: 1.5rem 1rem;
      box-shadow: 4px 0 15px rgba(0, 0, 0, 0.3);
      position: fixed;
      top: 0;
      left: 0;
    }

    .sidebar h2 {
      text-align: center;
      margin-bottom: 2rem;
      color: #4da6ff;
      font-weight: 600;
      font-size: 1.4rem;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0.9rem 1rem;
      color: #dcdcdc;
      text-decoration: none;
      border-radius: 8px;
      margin-bottom: 0.5rem;
      transition: 0.25s ease;
      font-size: 0.95rem;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #1f1f1f;
      color: #4da6ff;
    }

    .main-content {
      margin-left: 260px;
      width: calc(100% - 260px);
      padding: 2rem 3rem;
      animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid #232323;
    }

    .header h1 {
      color: #4da6ff;
      font-size: 2rem;
      margin: 0;
    }

    .header span strong {
      color: #fff;
    }

    .renew-btn {
      background: #28a745;
      padding: 0.7rem 1.4rem;
      border-radius: 6px;
      color: white;
      text-decoration: none;
      font-size: 0.9rem;
      margin-left: 1rem;
      transition: 0.25s ease;
    }

    .renew-btn:hover {
      background: #23923e;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .card {
      background: #151515;
      padding: 1.5rem;
      border-radius: 14px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
      transition: 0.3s ease;
    }

    .card:hover {
      transform: translateY(-4px);
    }

    .card h3 {
      margin: 0;
      font-size: 1rem;
      color: #9e9e9e;
      font-weight: 500;
    }

    .card p {
      margin: 0;
      margin-top: 0.7rem;
      font-size: 2rem;
      font-weight: 700;
      color: #4da6ff;
    }
  </style>
</head>
<body>
  <%- include('partials/sidebar', { active: 'dashboard' }) %>

  <div class="main-content">
    <div class="header">
      <h1>Welcome, <%= user?.name || 'User' %>!</h1>
      <div>
        <span>Plan: <strong><%= currentPackage.name %></strong> | Expires: <strong><%= data?.subscriptionExpires || 'N/A' %></strong></span>
        <a href="/subscribe" class="renew-btn">Renew / Upgrade</a>
      </div>
    </div>

    <div class="stats-grid">
      <div class="card">
        <h3>Active Devices</h3>
        <p><%= data?.deviceCount || 0 %> / <%= currentPackage.maxDevices.toLocaleString() %></p>
      </div>
      <div class="card">
        <h3>Messages Sent Today</h3>
        <p><%= (user?.messageCount || 0).toLocaleString() %> / <%= (user?.messageLimit || 0).toLocaleString() %></p>
      </div>
    </div>
  </div>
</body>
</html>