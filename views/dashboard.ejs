<%- include('partials/header', { title: 'Dasbor', active: 'dashboard' }) %>

<div class="header">
  <h1>Selamat Datang, <%= user?.name || 'Pengguna' %>!</h1>
  <div class="header-actions">
    <span>Paket: <strong><%= currentPackage.name %></strong> | Kedaluwarsa: <strong><%= data?.subscriptionExpires || 'N/A' %></strong></span>
    <a href="/subscribe" class="btn">Perbarui / Tingkatkan</a>
  </div>
</div>

<div class="stats-grid">
  <div class="card">
    <h3>Perangkat Aktif</h3>
    <p><%= data?.deviceCount || 0 %> / <%= currentPackage.maxDevices.toLocaleString() %></p>
  </div>
  <div class="card">
    <h3>Pesan Terkirim Hari Ini</h3>
    <p><%= (user?.messageCount || 0).toLocaleString() %> / <%= (user?.messageLimit || 0).toLocaleString() %></p>
  </div>
</div>

<%- include('partials/footer') %>
