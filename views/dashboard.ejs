<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Dashboard</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
    .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
    .sidebar h2 { text-align: center; color: #007bff; }
    .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
    .sidebar a.active, .sidebar a:hover { background: #333; }
    .main-content { margin-left: 270px; padding: 2rem; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 1rem; }
    .header h1 { color: #007bff; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 2rem; }
    .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; }
    .card h3 { margin-top: 0; color: #999; }
    .card p { font-size: 2rem; font-weight: bold; margin: 0; color: #007bff; }
    .renew-btn { background-color: #28a745; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; }
  </style>
</head>
<body>
  <%- include('partials/sidebar', { active: 'dashboard' }) %>

  <div class="main-content">
    <div class="header">
      <h1>Welcome, <%= user?.name || 'User' %>!</h1>
      <div>
        <span>Plan: <strong><%= currentPackage.name %></strong> | Expires:
          <strong><%= data?.subscriptionExpires || 'N/A' %></strong>
        </span>
        <a href="/subscribe" class="renew-btn" style="margin-left: 1rem;">Renew / Upgrade</a>
      </div>
    </div>

    <div class="stats-grid">
      <div class="card">
        <h3>Active Devices</h3>
        <p><%= data?.deviceCount || 0 %> / <%= currentPackage.name === 'Premium' ? 'Unlimited' : currentPackage.maxDevices %></p>
      </div>
      <div class="card">
        <h3>Messages Sent Today</h3>
        <p><%= data?.messageCount || 0 %> / <%= currentPackage.name === 'Premium' ? 'Unlimited' : currentPackage.messageLimit %></p>
      </div>
    </div>
  </div>
</body>
</html>
