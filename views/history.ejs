<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transaction History</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #121212; color: white; margin: 0; }
        .sidebar { position: fixed; width: 250px; height: 100%; background: #1e1e1e; padding: 1rem; }
        .sidebar h2 { text-align: center; color: #007bff; }
        .sidebar a { display: block; color: white; padding: 1rem; text-decoration: none; border-radius: 4px; }
        .sidebar a:hover { background: #333; }
        .main-content { margin-left: 270px; padding: 2rem; }
        h1 { color: #007bff; }
        .card { background: #1e1e1e; padding: 1.5rem; border-radius: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
        th, td { padding: 1rem; text-align: left; border-bottom: 1px solid #333; }
        th { background-color: #2c2c2c; }
        .status { padding: 0.25rem 0.5rem; border-radius: 4px; color: white; text-transform: capitalize; }
        .status-success { background-color: #28a745; }
        .status-pending { background-color: #ffc107; }
        .status-failed { background-color: #dc3545; }
    </style>
</head>
<body>
    <%- include('partials/sidebar', { active: 'history' }) %>
    <div class="main-content">
        <h1>Transaction History</h1>
        <div class="card">
            <table>
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Package</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Transaction Date</th>
                        <th>Expires On</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (transactions && transactions.length > 0) { %>
                        <% transactions.forEach(trx => { %>
                            <tr>
                                <td><%= trx.orderId %></td>
                                <td><%= trx.package.name %></td>
                                <td>IDR <%= trx.amount.toLocaleString() %></td>
                                <td><span class="status status-<%= trx.status %>"><%= trx.status %></span></td>
                                <td><%= new Date(trx.createdAt).toLocaleDateString() %></td>
                                <td><%= trx.expiresAt ? new Date(trx.expiresAt).toLocaleDateString() : 'N/A' %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="text-align: center;">No transactions found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
