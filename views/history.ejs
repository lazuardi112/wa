<%- include('partials/header', { title: 'Riwayat Transaksi', active: 'history' }) %>

<div class="header">
  <h1>Riwayat Transaksi</h1>
</div>

<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>ID Pesanan</th>
        <th>Paket</th>
        <th>Jumlah</th>
        <th>Status</th>
        <th>Tanggal Transaksi</th>
        <th>Kedaluwarsa Pada</th>
      </tr>
    </thead>
    <tbody>
      <% if (transactions && transactions.length > 0) { %>
        <% transactions.forEach(trx => { %>
          <tr>
            <td><%= trx.orderId %></td>
            <td><%= trx.package.name %></td>
            <td>IDR <%= trx.amount.toLocaleString() %></td>
            <td><span class="status status-<%= trx.status %>"><%= trx.status %></span></td>
            <td><%= new Date(trx.createdAt).toLocaleDateString('id-ID') %></td>
            <td><%= trx.expiresAt ? new Date(trx.expiresAt).toLocaleDateString('id-ID') : 'N/A' %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="6" style="text-align: center;">Tidak ada transaksi ditemukan.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
