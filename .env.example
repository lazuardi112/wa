# Backend Configuration
PORT=8080
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=wagateway
SESSION_SECRET=a_very_strong_secret_key_that_you_should_change

# Frontend Development Configuration
# These are for the React development server (npm run dev)
DANGEROUSLY_DISABLE_HOST_CHECK=true
HOST=0.0.0.0

# Production Configuration
# The PUBLIC_URL is used during the `npm run build` process to set the correct asset paths.
# For production, it should typically be the root path '/'.
PUBLIC_URL=/
